<Window x:Class="PickChatter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PickChatter"
        mc:Ignorable="d"
        Title="PickChatter" Height="503" Width="738" MinWidth="800" MinHeight="500">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="92*"/>
            <RowDefinition Height="125*"/>
        </Grid.RowDefinitions>
        <TabControl x:Name="ChattersTabContainer" Margin="10,10,10,79" Grid.RowSpan="2">
            <TabItem Header="Chatter 1">

            </TabItem>
        </TabControl>
        <StatusBar x:Name="MyStatusBar" Grid.Row="1" Height="20" VerticalAlignment="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding CurrentPicker.StatusBarString, Mode=OneWay, TargetNullValue=''}" />
            </StatusBarItem>
            <StatusBarItem Margin="20,0">
                <TextBlock Text="{Binding StatusBarString, Mode=OneWay, Source={x:Static local:TwitchClient.Instance}, TargetNullValue=''}" />
            </StatusBarItem>
        </StatusBar>
        <Button Content="Settings" Margin="0,0,10,25" FontSize="14" Height="30" VerticalAlignment="Bottom" HorizontalAlignment="Right" Width="100" Click="SettingsButton_Click" Grid.Row="1" />
        <Button Content="Remove chatter" Margin="10,0,0,25" FontSize="14" Height="30" VerticalAlignment="Bottom" Click="RemoveChatterButton_Click" Grid.Row="1" HorizontalAlignment="Left" Width="120" />
    </Grid>
</Window>
