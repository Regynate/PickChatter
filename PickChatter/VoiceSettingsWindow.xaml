<Window x:Class="PickChatter.VoiceSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PickChatter"
        mc:Ignorable="d"
        Title="Voice Settings" Height="170" Width="391" ResizeMode="NoResize">
    <Window.Resources>
        <local:EnumBooleanConverter x:Key="EnumBooleanConverter" />
    </Window.Resources>
    <Grid>
        <StackPanel HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" Orientation="Vertical">
            <StackPanel HorizontalAlignment="Left" Margin="0,0,0,0" VerticalAlignment="Top" Orientation="Horizontal">
                <RadioButton x:Name="VoiceType1" GroupName="VoiceType" Content="Microsoft voice" IsChecked="{Binding SpeechSynthesisType, Converter={StaticResource EnumBooleanConverter}, ConverterParameter=MicrosoftSynthesis}"/>
                <StackPanel HorizontalAlignment="Left" Margin="10,0,0,0" VerticalAlignment="Top" Orientation="Horizontal" IsEnabled="{Binding ElementName=VoiceType1, Path=IsChecked}">
                    <ComboBox Width="250" Margin="0,0,0,0"  ItemsSource="{Binding Source={x:Static local:MicrosoftSpeechManager.Instance}, Path=AvailableVoices}" SelectedItem="{Binding MicrosoftVoice, FallbackValue=Hello}" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                </StackPanel>
            </StackPanel>
            <StackPanel HorizontalAlignment="Left" Margin="0,5,0,0" VerticalAlignment="Top" Orientation="Horizontal">
                <RadioButton x:Name="VoiceType2" GroupName="VoiceType" Content="Amazon voice" IsChecked="{Binding SpeechSynthesisType, Converter={StaticResource EnumBooleanConverter}, ConverterParameter=AmazonSynthesis}"/>
                <StackPanel HorizontalAlignment="Left" Margin="16,0,0,0" VerticalAlignment="Top" Orientation="Horizontal" IsEnabled="{Binding ElementName=VoiceType2, Path=IsChecked}">
                    <ComboBox Width="250" Margin="0,0,0,0"  ItemsSource="{Binding Source={x:Static local:AmazonSpeechManager.Instance}, Path=AvailableVoices}" SelectedItem="{Binding AmazonVoice}" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                </StackPanel>
            </StackPanel>
            <StackPanel HorizontalAlignment="Left" Margin="0,5,0,0" VerticalAlignment="Top" Orientation="Horizontal">
                <RadioButton x:Name="VoiceType3" GroupName="VoiceType" Content="Elevenlabs voice" IsChecked="{Binding SpeechSynthesisType, Converter={StaticResource EnumBooleanConverter}, ConverterParameter=ElevenlabsSynthesis}"/>
                <StackPanel HorizontalAlignment="Left" Margin="4,0,0,0" VerticalAlignment="Top" Orientation="Horizontal" IsEnabled="{Binding ElementName=VoiceType3, Path=IsChecked}">
                    <ComboBox Width="250" Margin="0,0,0,0"  ItemsSource="{Binding Source={x:Static local:ElevenlabsSpeechManager.Instance}, Path=AvailableVoices}" SelectedItem="{Binding ElevenlabsVoice}" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                </StackPanel>
            </StackPanel>
            <!--<StackPanel HorizontalAlignment="Left" Margin="0,5,0,0" VerticalAlignment="Top" Orientation="Horizontal">
                <RadioButton x:Name="VoiceType3" GroupName="VoiceType" Content="Google voice" IsChecked="{Binding SpeechSynthesisType, Converter={StaticResource EnumBooleanConverter}, ConverterParameter=GoogleSynthesis}"/>
                <StackPanel HorizontalAlignment="Left" Margin="22,0,0,0" VerticalAlignment="Top" Orientation="Horizontal" IsEnabled="{Binding ElementName=VoiceType3, Path=IsChecked}">
                    <ComboBox Width="250" Margin="0,0,0,0"  ItemsSource="{Binding Source={x:Static local:GoogleSpeechManager.Instance}, Path=AvailableVoices}" SelectedItem="{Binding GoogleVoice}" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                </StackPanel>
            </StackPanel>-->
        </StackPanel>
        <Button Content="Test" HorizontalAlignment="Left" Margin="20,0,0,10" Width="76" Click="TestVoiceButton_Click" Height="23" VerticalAlignment="Bottom"/>
        <Button Content="Save" Margin="0,0,21,12" Height="23" VerticalAlignment="Bottom" HorizontalAlignment="Right" Width="76" Click="SaveButton_Click"/>
    </Grid>
</Window>
