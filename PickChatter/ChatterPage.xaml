<Page x:Class="PickChatter.ChatterPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PickChatter"
      mc:Ignorable="d" 
      d:DesignHeight="350" d:DesignWidth="780"
      Title="ChatterPage">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
    </Page.Resources>

    <Grid Background="White">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="29*"/>
            <ColumnDefinition Width="11*"/>
            <ColumnDefinition Width="734*"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="{Binding Path=ChatterPicker.ChatterName, Mode=OneWay, StringFormat=Selected chatter: \{0\}, TargetNullValue=Selected chatter: -}" FontSize="20" HorizontalAlignment="Left" Height="59" Margin="1,70,0,0" VerticalAlignment="Top" Width="360" FontFamily="./#Cascadia Mono" TextWrapping="WrapWithOverflow" Grid.Column="2"/>
        <Button x:Name="PickRandomChatterButton" Content="Pick random chatter" Margin="1,217,0,0" Height="48" Width="360" FontSize="18" VerticalAlignment="Top" HorizontalAlignment="Left" Click="PickRandomChatterButton_Click" Grid.Column="2" />
        <Button x:Name="SelectSpecificChatterButton" Content="Select" HorizontalAlignment="Left" Margin="257,166,0,0" VerticalAlignment="Top" Height="30" Width="100" FontSize="16" Click="SelectSpecificChatterButton_Click" Grid.Column="2"/>
        <StackPanel HorizontalAlignment="Left" Margin="3,280,0,0" VerticalAlignment="Top" Orientation="Horizontal" Visibility="{Binding AutoPickingEnabled, Converter={StaticResource BoolToVisConverter}, Source={x:Static local:SettingsManager.Instance}}" Grid.Column="2" Height="43" Width="358">
            <Button x:Name="AutoPickButton" Content="{Binding AutoPicker.StartButtonText}" Margin="0,0,0,0" Height="36" Width="180" FontSize="14" VerticalAlignment="Top" HorizontalAlignment="Left" Click="AutoPickButton_Click" />
            <TextBlock Margin="20,0,0,0" VerticalAlignment="Center" FontSize="18" Text="{Binding AutoPicker.RemainingTimeString, Mode=OneWay, TargetNullValue=0:00}" />
        </StackPanel>
        <TextBox HorizontalAlignment="Left" Padding="10,3,0,0" Height="30" Margin="1,166,0,0" x:Name="PickSpecificTextBox" VerticalAlignment="Top" Width="255" FontSize="16" MaxLines="1" Grid.Column="2"/>
        <TextBlock IsHitTestVisible="False" Text="Pick specific chatter" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="10,170,0,0" Foreground="DarkGray" FontSize="16" Grid.Column="2" Height="21" Width="138">
            <TextBlock.Style>
                <Style TargetType="{x:Type TextBlock}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Text, ElementName=PickSpecificTextBox}" Value="">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
        <TextBlock Margin="380,12,10,154" TextWrapping="Wrap" Text="{Binding ChatterPicker.LastMessage, Mode=OneWay, TargetNullValue=''}" Grid.Column="2"/>
        <Button Content="{Binding ChatterPicker.SpeechManager.SpeakButtonText, FallbackValue=Play}" IsEnabled="{Binding SpeechSynthesisEnabled, Source={x:Static local:SettingsManager.Instance}}" Margin="0,0,40,10" FontSize="16" HorizontalAlignment="Right" Width="100" Click="SpeakButton_Click" Grid.Column="2" Height="30" VerticalAlignment="Bottom"/>
        <TextBox HorizontalAlignment="Left" Padding="10,3,0,0" Height="30" Margin="128,10,0,0" x:Name="ChatterIDTextBox" VerticalAlignment="Top" Width="229" FontSize="16" MaxLines="1" Grid.Column="2" Text="{Binding Path=ChatterPicker.ID, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
        <Label Grid.Column="1" Content="Chatter ID:" HorizontalAlignment="Left" Margin="11,10,0,0" RenderTransformOrigin="0.5,0.5" Width="123" FontSize="20" Padding="0,0,0,0" VerticalContentAlignment="Center" Grid.ColumnSpan="2" Height="30" VerticalAlignment="Top"/>
        <Label Grid.Column="2" Content="{Binding Path=ChatterPicker.VoiceSettings.VoiceName, Mode=OneWay, TargetNullValue=-}" ContentStringFormat="Voice: {0}" HorizontalAlignment="Left" Margin="1,0,0,32" RenderTransformOrigin="0.5,0.5" Width="361" FontSize="20" Padding="0,0,0,0" VerticalContentAlignment="Center" Height="30" VerticalAlignment="Bottom"/>
        <Button x:Name="VoiceSettingsButton" Content="Voice Settings" Margin="0,0,185,10" FontSize="16" HorizontalAlignment="Right" Width="126" Grid.Column="2" Click="VoiceSettingsButton_Click" Height="30" VerticalAlignment="Bottom" />
    </Grid>
</Page>
